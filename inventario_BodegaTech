-- ── SECCIÓN DDL ──────────────────────────
DROP TABLE IF EXISTS inventario;

CREATE TABLE inventario(
id_producto INT NOT NULL IDENTITY (1,1) PRIMARY KEY,
nombre_producto VARCHAR(100) NOT NULL, --El nombre del producto es en formato texto y con un límite de 100 caracteres porque al ser productos tecnológicos pueden ser extensos.
categoria VARCHAR(50) NOT NULL, --La categoría del producto es en formato texto y con un límite de 50 caracteres porque no debería extenderse más de esa cantidad.
precio_unitario DECIMAL(10,2) NOT NULL, --El precio está expresado en decimales de hasta 10 números y 2 decimales porque es el estándar en montos.
stock_actual INT NOT NULL, --El stock se visualiza en números enteros para mayor legibilidad.
stock_minimo INT NOT NULL,
fecha_ingreso DATE NOT NULL,
activo TINYINT NOT NULL --El comando TINYINT por default ya ocupa espacio de 1 byte y por lo tanto no es necesario aclarar (1) como fue solicitado en la consigna.
);

